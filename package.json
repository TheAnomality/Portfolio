{
  "name": "theanomality-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "TheAnomality's portfolio: React, Three.js (React Three Fiber), Motion and a HyperFrames showreel. Hosts the Atom and AnimeWiki projects inside it.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit -p tsconfig.json",
    "sync:projects": "node scripts/sync-projects.mjs",
    "showreel:preview": "cd showreel && npx --yes hyperframes@latest preview",
    "showreel:render": "node scripts/render-showreel.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.1",
    "lenis": "^1.3.29",
    "motion": "^14.14.0",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  }
}
