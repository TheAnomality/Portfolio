# Contact form (api/contact.js). Set these in Vercel → Settings → Environment
# Variables. For local testing with `vercel dev`, run `vercel env pull` instead
# of copying this file; never commit real keys.

# Resend API key (https://resend.com/api-keys), starts with "re_"
RESEND_API_KEY=

# Where messages are delivered (the email you signed up to Resend with,
# until you verify a domain in Resend)
CONTACT_TO_EMAIL=

# Optional, after verifying a domain in Resend, e.g.
# CONTACT_FROM_EMAIL="TheAnomality <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=
